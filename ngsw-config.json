{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.css",
          "/*.js",
          "/manifest.webmanifest"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/icons/**",
          "/demo/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "catalogo-imagenes",
      "urls": [
        "/api/v1/media/files/**",
        "https://**/api/v1/media/files/**",
        "/media/**",
        "https://**/storage/v1/object/public/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 300,
        "maxAge": "7d"
      }
    }
  ]
}
